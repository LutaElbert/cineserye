{
  "name": "cineserye",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preflight:gcloud": "node scripts/check-cineserye-gcloud.mjs",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "start": "vinext start",
    "check": "vinext check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern artifacts/simplified-flow/browser-modules",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:built:node": "node scripts/test-built.mjs node-fixture",
    "test:built:worker": "node scripts/test-built.mjs worker",
    "check:test-environment": "node scripts/check-test-environment.mjs",
    "preview": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy:preview": "vinext-cloudflare deploy --preview --config wrangler.jsonc",
    "deploy": "vinext-cloudflare deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.20.0",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@xyflow/react": "^12.11.5",
    "dompurify": "^3.4.14",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260829.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "type": "module"
}
